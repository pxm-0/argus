[Unit]
Description=Argus nightly encrypted state snapshot
After=network.target
OnFailure=argus-backup-snapshot-failure.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/argus
ExecStart=/usr/bin/python3 /srv/argus/scripts/argus-backup-snapshot --reason nightly --recipient-file /etc/argus/snapshot-recipients.txt --pull-dir /var/backups/argus-snapshots-pull --json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
