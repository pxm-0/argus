[Unit]
Description=Argus typed operation agent for %i
Requires=argus-operation-worker.service argus-capability-issuer.service
After=network.target argus-operation-worker.service argus-capability-issuer.service

[Service]
Type=simple
User=argus-%i
Group=argus-control
WorkingDirectory=/srv/argus
Environment=ARGUS_ROOT=/srv/argus
Environment=ARGUS_RUNTIME=/srv/argus/runtime/argus/m5
Environment=ARGUS_OPERATIONS_DB=/var/lib/argus/control/operations.sqlite3
Environment=ARGUS_LEDGER_REQUIRE_EXISTING=1
Environment=ARGUS_TRUST_DOMAIN=%i
Environment=ARGUS_ISSUER_SOCKET=/run/argus/capability-issuer.sock
Environment=ARGUS_ISSUER_PUBLIC_KEY=/etc/argus/domains/%i/issuer.pub
Environment=ARGUS_ISSUER_PREVIOUS_PUBLIC_KEY=/etc/argus/domains/%i/issuer.previous.pub
Environment=ARGUS_AGENT_SOCKET=/run/argus/domains/%i/agent.sock
Environment=ARGUS_CAPABILITY_REPLAY_DB=/var/lib/argus/%i/capabilities.sqlite3
Environment=HOME=/var/lib/argus/%i
ExecStart=/usr/bin/python3 /srv/argus/scripts/argus_domain_agent.py
Restart=on-failure
RestartSec=3
UMask=0007
RuntimeDirectory=argus/domains/%i
RuntimeDirectoryMode=0770
StateDirectory=argus/%i
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock
ReadWritePaths=/srv/argus/runtime/argus -/srv/argus/runtime/audit.log /var/lib/argus/control /srv/argus/runtime/backups /srv/argus/config /srv/argus/control-plane/dashboard/public

[Install]
WantedBy=multi-user.target
