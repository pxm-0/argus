[Unit]
Description=Argus durable migration parent coordinator
Requires=argus-operation-worker.service
After=argus-operation-worker.service
Before=argus-control-api.service

[Service]
Type=simple
User=argus-worker
Group=argus-control
WorkingDirectory=/srv/argus
Environment=ARGUS_ROOT=/srv/argus
Environment=ARGUS_OPERATIONS_DB=/var/lib/argus/control/operations.sqlite3
Environment=ARGUS_OBSERVATIONS_DB=/srv/argus/runtime/argus/observations.sqlite3
ExecStart=/usr/bin/python3 /srv/argus/scripts/argus_migration_coordinator.py
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/argus
ReadWritePaths=/var/lib/argus/control
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock

[Install]
WantedBy=multi-user.target
