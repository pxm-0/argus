[Unit]
Description=Argus bounded optional evidence collector %i
After=local-fs.target

[Service]
Type=simple
User=oreo
Group=argus-control
WorkingDirectory=/srv/argus
Environment=ARGUS_SOURCE_ID=oreochiserver.%i
Environment=ARGUS_SOURCE_REGISTRY=/etc/argus/collectors/optional/%i.json
Environment=ARGUS_SOURCE_CONFIG_UID=0
Environment=ARGUS_SOURCE_CONFIG_GID=981
Environment=ARGUS_SOURCE_CONFIG_MODE=0640
Environment=ARGUS_COLLECTOR_CLIENT_UID=1000
Environment=ARGUS_COLLECTOR_CLIENT_GID=981
Environment=ARGUS_REPO_ROOT=/srv/argus
ExecStart=/usr/bin/python3 /srv/argus/scripts/argus_optional_evidence_collector.py
Restart=on-failure
RestartSec=3
UMask=0007
RuntimeDirectory=argus/collectors/optional/%i
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# This source intentionally observes the host listener table through AF_NETLINK;
# it has no AF_INET/AF_INET6 capability and no route or mutation surface.
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
ReadOnlyPaths=/srv/argus/scripts /srv/argus/config /srv/argus/workloads /etc/argus/collectors/optional/%i.json
ReadWritePaths=/run/argus/collectors/optional/%i
InaccessiblePaths=/var/run/docker.sock /run/docker.sock /etc/argus/operators.json /etc/argus/control-token /etc/argus/operator-proxy-token /srv/argus/control-plane /srv/argus/runtime /srv/argus/tests /srv/argus/docs /run/argus/domains

[Install]
WantedBy=multi-user.target
