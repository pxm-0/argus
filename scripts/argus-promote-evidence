#!/usr/bin/env python3
"""Print {"ok": true, "deployed": bool}: did a workload.deploy of this image ID succeed in the operations ledger.

The ledger is argus-control only, so `argus promote` runs this over `ssh host sudo -n`
when its own user cannot read it. Read-only; prints no ledger content.
"""
from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from argus_release import IMAGE_ID, WORKLOAD_ID, ledger_has_deploy  # noqa: E402

LEDGER = Path("/var/lib/argus/control/operations.sqlite3")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workload", required=True)
    parser.add_argument("--image", required=True)
    parser.add_argument("--ledger", default=str(LEDGER), help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if not WORKLOAD_ID.fullmatch(args.workload) or not IMAGE_ID.fullmatch(args.image):
        print(json.dumps({"ok": False, "error": "invalid-arguments"}))
        return 2
    try:
        deployed = ledger_has_deploy(Path(args.ledger), args.workload, args.image)
    except (OSError, RuntimeError, ValueError, sqlite3.Error) as exc:
        print(json.dumps({"ok": False, "error": type(exc).__name__}))
        return 4
    print(json.dumps({"ok": True, "deployed": deployed}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
