#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

from argus_common import fail, load_json, root


def render(routes: dict[str, Any]) -> str:
    dashboard = routes["dashboard"]
    api = routes["api"]
    port = int(dashboard["port"])
    if dashboard.get("bind") != "tailscale":
        fail("dashboard route must bind to tailscale in P0")
    if api.get("bind") != "127.0.0.1" or bool(api.get("public")):
        fail("control API must remain private at 127.0.0.1")
    return f"""# Private Argus backend for Tailscale Serve.
# Caddy replaces untrusted identity headers and authenticates itself to the API.
# Match the original tailnet Host header while listening only on loopback.
http://:{port} {{
\tbind 127.0.0.1
\troot * /srv/argus/control-plane/dashboard/public
\thandle /api/* {{
\t\troute {{
\t\t\t# Preserve only the two client-supplied Argus CSRF headers.
\t\t\tvars {{
\t\t\t\targus_csrf {{http.request.header.X-Argus-CSRF}}
\t\t\t\targus_csrf_bootstrap {{http.request.header.X-Argus-CSRF-Bootstrap}}
\t\t\t\targus_tailnet_login {{http.request.header.Tailscale-User-Login}}
\t\t\t}}
\t\t\trequest_header -X-Argus-*
\t\t\trequest_header X-Argus-CSRF {{vars.argus_csrf}}
\t\t\trequest_header X-Argus-CSRF-Bootstrap {{vars.argus_csrf_bootstrap}}
\t\t\trequest_header X-Argus-Tailnet-Login {{vars.argus_tailnet_login}}
\t\t\trequest_header X-Argus-Proxy-Token {{$ARGUS_OPERATOR_PROXY_TOKEN}}
\t\t\trequest_header -Tailscale-*
\t\t\treverse_proxy {api["bind"]}:{api["port"]}
\t\t}}
\t}}
\tfile_server
}}
"""


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate the private Argus dashboard Caddy route.")
    parser.add_argument("--json", action="store_true", help="Print route metadata as JSON.")
    args = parser.parse_args()
    routes = load_json("routes.json")
    content = render(routes)
    output = root() / "caddy" / "dashboard.Caddyfile"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(content)
    payload = {
        "ok": True,
        "generated": str(output),
        "bind": "127.0.0.1",
        "port": routes["dashboard"]["port"],
        "apiProxy": f'{routes["api"]["bind"]}:{routes["api"]["port"]}',
        "manualInstallRequired": True,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print("Private Caddy Dashboard Route")
        print("")
        print(f"Generated: {output}")
        print(f"Bind: {payload['bind']}:{payload['port']}")
        print(f"API proxy: {payload['apiProxy']}")
        print("")
        print("Manual install after review:")
        print('sudo cp /etc/caddy/Caddyfile "/etc/caddy/Caddyfile.backup.$(date +%Y%m%d-%H%M%S)"')
        print("sudo caddy validate --config /etc/caddy/Caddyfile")
        print("sudo systemctl reload caddy")
        print("")
        print("No Caddyfile was installed, no service was reloaded, and no public route was exposed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
