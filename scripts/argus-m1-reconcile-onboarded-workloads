#!/usr/bin/env python3
"""Register reviewed, newly onboarded Argus workloads in private M1 state."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from argus_m1_onboarded_workloads import reconcile_onboarded_workloads
from argus_m1_retired_workloads import RetirementReconcileError


ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description="Insert reviewed active workloads that are missing from private M1 state.")
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--acknowledge-onboarded-workload-registration", action="store_true")
    args = parser.parse_args()
    if args.apply and not args.acknowledge_onboarded_workload_registration:
        raise SystemExit("refusing apply without --acknowledge-onboarded-workload-registration")
    try:
        print(json.dumps(reconcile_onboarded_workloads(args.root, apply=args.apply), sort_keys=True))
    except RetirementReconcileError as exc:
        raise SystemExit(f"Argus onboarded workload registration failed: {exc}") from exc
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
