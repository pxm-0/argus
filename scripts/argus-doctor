#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import binascii
import grp
import json
import os
import pwd
import shutil
import stat
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable

from argus_common import load_json, print_json, root
from argus_sudoers import findings as sudoers_findings, parse_entries as parse_sudoers


SECRET_SUFFIXES = {".pem", ".key", ".p12", ".pfx", ".token"}
SECRET_NAMES = {".env", "control-token", "audit.log"}
SAFE_CLOUDFLARE_PRIVACY = {"unclassified", "personal", "internal"}
SUDOERS_DIR = Path("/etc/sudoers.d")
# Operator-accepted exceptions: reported as warnings, never hidden.
SUDOERS_WARN_ONLY = {
    "90-codex-nopasswd": "legacy broad grant; remove last in docs/RUNBOOKS/sudo-narrowing.md",
    "oreo-yog-sothoth": "separate yog-sothoth grant retained by operator decision",
}
GHCR_CONFIG = Path("/etc/argus/registry/.docker/config.json")
GHCR_STAMP = Path("/var/lib/argus/ghcr-token-rotated")
GHCR_WARN_DAYS, GHCR_FAIL_DAYS = 75, 90
GHCR_SCOPES = {"read:packages"}


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=root(), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)


def tracked_files() -> list[str]:
    result = run(["git", "ls-files"])
    if result.returncode != 0:
        return []
    return result.stdout.splitlines()


def add(checks: list[dict[str, Any]], ok: bool, message: str, **extra: Any) -> None:
    checks.append({"ok": ok, "message": message, **extra})


def has_secret_shape(path: str) -> bool:
    item = Path(path)
    lowered = path.lower()
    return (
        item.name.lower() in SECRET_NAMES
        or item.suffix.lower() in SECRET_SUFFIXES
        or item.name.lower().startswith(".env.")
        or "credential" in lowered
        or "secret" in lowered
    )


def config_valid(checks: list[dict[str, Any]]) -> None:
    for name in ["workloads.json", "access.json", "privacy.json", "policy.json", "routes.json", "exposure.json", "monitoring.json"]:
        try:
            json.loads((root() / "config" / name).read_text())
        except Exception as exc:  # noqa: BLE001 - doctor should report concise failures.
            add(checks, False, f"config/{name} valid", error=exc.__class__.__name__)
        else:
            add(checks, True, f"config/{name} valid")
    for name in ["legacy-classification.json", "workload-classification.json"]:
        try:
            json.loads((root() / "config" / "argus" / name).read_text())
        except Exception as exc:  # noqa: BLE001 - doctor should report concise failures.
            add(checks, False, f"config/argus/{name} valid", error=exc.__class__.__name__)
        else:
            add(checks, True, f"config/argus/{name} valid")


def argus_quarantine_checks(checks: list[dict[str, Any]]) -> None:
    tracked = {str(item.get("id")) for item in load_json("workloads.json").get("workloads", [])}
    baseline = load_json("argus/legacy-classification.json")
    classified = baseline.get("workloads", {})
    expected = {
        "realm": "unclassified",
        "zone": "legacy",
        "stage": "none",
        "trustDomain": "legacy-rootful",
        "status": "legacy-unclassified",
        "admission": "denied",
    }
    invalid = sorted(
        workload_id
        for workload_id, classification in classified.items()
        if not isinstance(classification, dict)
        or any(classification.get(key) != value for key, value in expected.items())
    )
    add(checks, tracked == set(classified), "every tracked workload has an Argus quarantine record")
    add(checks, not invalid, "Argus legacy classifications are fail-closed", workloads=invalid)
    rules = load_json("policy.json").get("rules", {})
    add(checks, rules.get("allowNewLegacyRootfulAdmission") is False, "new legacy-rootful admission denied")
    add(checks, rules.get("requireLegacyUnclassifiedQuarantine") is True, "legacy quarantine required")


def tracks_reviewed_compose(workload_id: str) -> bool:
    """A manifest may opt in to tracking only its reviewed source/compose.yml."""
    try:
        manifest = json.loads((root() / "workloads" / workload_id / "manifest.json").read_text())
    except (OSError, json.JSONDecodeError):
        return False
    security = manifest.get("security") if isinstance(manifest, dict) else None
    return isinstance(security, dict) and security.get("trackedByArgusGit") is True


def tracked_file_checks(checks: list[dict[str, Any]]) -> None:
    items = tracked_files()
    add(checks, bool(items), "tracked file inventory available")
    secret_like = [item for item in items if has_secret_shape(item)]
    runtime = [item for item in items if Path(item).parts[:1] == ("runtime",) and Path(item).name != ".gitkeep"]
    workload_source = []
    for item in items:
        parts = Path(item).parts
        if len(parts) >= 3 and parts[0] == "workloads" and parts[2] in {"source", "app", "repo", "data", "backups", "runtime", "logs"}:
            if parts[2:] == ("source", "compose.yml") and tracks_reviewed_compose(parts[1]):
                continue
            workload_source.append(item)
    add(checks, not secret_like, "no tracked secrets or credentials", paths=secret_like)
    add(checks, not runtime, "no tracked runtime artifacts", paths=runtime)
    add(checks, not workload_source, "no tracked workload source or runtime data", paths=workload_source)


def cloudflare_access_evidence_exists(workload_id: str) -> bool:
    evidence_dir = root() / "runtime" / "cloudflare-activation"
    if not evidence_dir.exists():
        return False
    for path in evidence_dir.glob("*.json"):
        try:
            payload = json.loads(path.read_text())
        except Exception:
            continue
        probe = payload.get("unauthenticatedProbe", {})
        validation = payload.get("validation", {})
        if (
            payload.get("ok") is True
            and payload.get("workloadId") == workload_id
            and probe.get("blocked") is True
            and validation.get("ok") is True
        ):
            return True
    return False


def exposure_checks(checks: list[dict[str, Any]]) -> None:
    access = load_json("access.json")
    routes = load_json("routes.json")
    exposure = load_json("exposure.json")
    policy = load_json("policy.json")
    privacy = load_json("privacy.json")
    workloads = {str(item.get("id")): item for item in load_json("workloads.json").get("workloads", [])}

    api = routes.get("api", {})
    add(checks, api.get("bind") == "127.0.0.1" and api.get("public") is False, "control API is localhost-only")

    caddy_path = root() / "caddy" / "dashboard.Caddyfile"
    if caddy_path.exists():
        caddy = caddy_path.read_text()
        add(checks, "bind 0.0.0.0" not in caddy, "dashboard Caddy route is not wildcard-bound")
        add(checks, "reverse_proxy 127.0.0.1:8099" in caddy, "dashboard Caddy proxies API locally")
    else:
        add(checks, True, "dashboard Caddy plan absent")

    observed_funnel = bool(routes.get("observed", {}).get("funnel", {}).get("enabled")) or bool(
        exposure.get("providers", {}).get("tailscale", {}).get("funnel", {}).get("observedEnabled")
    )
    add(checks, policy.get("rules", {}).get("allowFunnelInP0") is False, "Funnel disallowed in policy")
    add(checks, not observed_funnel, "no observed Funnel exposure")

    cloudflare = exposure.get("providers", {}).get("cloudflare", {})
    add(checks, cloudflare.get("allowQuickTunnels") is False, "quick tunnels disabled")
    protected_without_access_evidence = [
        workload_id
        for workload_id, item in access.get("workloads", {}).items()
        if item.get("effective") == "cloudflare-protected" and not cloudflare_access_evidence_exists(workload_id)
    ]
    add(
        checks,
        not protected_without_access_evidence,
        "Cloudflare protected effective access has Access/Auth evidence",
        workloads=protected_without_access_evidence,
    )

    public_states = [
        workload_id
        for workload_id, item in access.get("workloads", {}).items()
        if item.get("desired") == "cloudflare-public" or item.get("effective") == "cloudflare-public"
    ]
    add(checks, not public_states, "cloudflare-public absent in P2 access state", workloads=public_states)

    unsafe_external = []
    for workload_id, item in access.get("workloads", {}).items():
        effective = str(item.get("effective", ""))
        route = routes.get("workloadRoutes", {}).get(workload_id, {}).get("cloudflare", {})
        privacy_state = privacy.get("workloads", {}).get(workload_id, {}).get("privacy", privacy.get("defaultPrivacy", ""))
        workload = workloads.get(workload_id, {})
        external = effective.startswith("cloudflare") or bool(route.get("enabled"))
        if external and (privacy_state not in SAFE_CLOUDFLARE_PRIVACY or workload.get("kind") == "admin-tool"):
            unsafe_external.append(workload_id)
    add(checks, not unsafe_external, "no sensitive/restricted/admin workload externally exposed", workloads=unsafe_external)


def cloudflare_ingress_checks(checks: list[dict[str, Any]]) -> None:
    routes = load_json("routes.json")
    privacy = load_json("privacy.json")
    workloads = {str(item.get("id")): item for item in load_json("workloads.json").get("workloads", [])}
    host_to_workload = {
        str(route.get("cloudflare", {}).get("hostname")): workload_id
        for workload_id, route in routes.get("workloadRoutes", {}).items()
        if route.get("cloudflare", {}).get("hostname")
    }
    ingress_path = root() / "cloudflare" / "planned-ingress.yml"
    blocked = []
    if ingress_path.exists():
        for line in ingress_path.read_text().splitlines():
            stripped = line.strip()
            if not stripped.startswith("- hostname:"):
                continue
            hostname = stripped.partition(":")[2].strip().strip('"')
            workload_id = host_to_workload.get(hostname, "")
            workload = workloads.get(workload_id, {})
            privacy_state = privacy.get("workloads", {}).get(workload_id, {}).get("privacy", privacy.get("defaultPrivacy", ""))
            haystack = json.dumps(workload, sort_keys=True).lower()
            if (
                workload.get("kind") == "admin-tool"
                or privacy_state not in SAFE_CLOUDFLARE_PRIVACY
                or any(marker in haystack for marker in ["postgres", "docker.sock", "docker-socket", "/.ssh", "control-api"])
            ):
                blocked.append(hostname)
    add(checks, not blocked, "no blocked workload in Cloudflare ingress", hostnames=blocked)


def reconcile_check(checks: list[dict[str, Any]]) -> None:
    script = root() / "scripts" / "argus-access-reconcile"
    result = run([str(script), "--offline", "--json"])
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        add(checks, False, "effective access reconcile JSON valid")
        return
    add(checks, result.returncode == 0 and payload.get("ok") is True, "effective access reconcile clean", failures=payload.get("failures"))


def host_health_checks(checks: list[dict[str, Any]]) -> None:
    """Check host prerequisites that cannot be inferred from repository files."""
    try:
        ssl_cert_group = grp.getgrnam("ssl-cert").gr_gid
    except KeyError:
        add(checks, False, "ssl-cert group available")
        return
    expectations = (
        (Path("/etc/ssl/certs"), 0, 0, 0o755, "SSL certificates directory ownership"),
        (Path("/etc/ssl/private"), 0, ssl_cert_group, 0o710, "SSL private directory ownership"),
    )
    for path, uid, gid, mode, message in expectations:
        try:
            metadata = path.lstat()
        except OSError:
            add(checks, False, message)
            continue
        add(
            checks,
            stat.S_ISDIR(metadata.st_mode)
            and metadata.st_uid == uid
            and metadata.st_gid == gid
            and stat.S_IMODE(metadata.st_mode) == mode,
            message,
        )
    try:
        cluster = run(["systemctl", "is-active", "--quiet", "postgresql@18-main.service"])
        readiness = run(["pg_isready", "-h", "127.0.0.1", "-p", "5432"])
    except OSError:
        add(checks, False, "PostgreSQL 18 health checks available")
        return
    add(checks, cluster.returncode == 0, "PostgreSQL 18 cluster active")
    add(checks, readiness.returncode == 0, "PostgreSQL accepts loopback readiness probe")


def api_service_user_checks(checks: list[dict[str, Any]]) -> None:
    """The control API must not run as a user that can reach root or docker."""
    unit = "argus-control-api.service"
    try:
        shown = run(["systemctl", "show", unit, "-p", "User", "-p", "CapabilityBoundingSet"])
    except OSError:
        add(checks, False, "control API unit properties available")
        return
    props = dict(line.split("=", 1) for line in shown.stdout.splitlines() if "=" in line)
    user = props.get("User", "").strip()
    add(checks, shown.returncode == 0 and bool(user), "control API runs as an explicit non-root user", user=user)
    if not user:
        return
    try:
        groups = run(["id", "-nG", user]).stdout.split()
    except OSError:
        groups = []
    privileged = sorted({"sudo", "docker"}.intersection(groups))
    add(checks, user != "root" and not privileged, "control API user is not root, sudo or docker", user=user, groups=privileged)
    add(
        checks,
        not props.get("CapabilityBoundingSet", "").strip(),
        "control API capability bounding set is empty",
        capabilityBoundingSet=props.get("CapabilityBoundingSet", "").strip(),
    )
    sudoers = Path("/etc/sudoers.d")
    try:
        named = sorted(
            item.name
            for item in sudoers.iterdir()
            if item.is_file() and any("NOPASSWD" in line and user in line.split() for line in item.read_text().splitlines())
        )
    except OSError:
        return  # unreadable without root; the host check runs as root
    if named:
        add(checks, True, "WARN: NOPASSWD sudoers drop-in names the control API user", warn=True, files=named)


def trusted_path_problem(path: str, trusted_uids: tuple[int, ...] = (0,), below: Path | None = None) -> str | None:
    """First component of the resolved path that is not owned by a trusted uid or is group/other writable.

    `below` limits the walk to that directory and its children (tests use it to skip /tmp and friends).
    """
    resolved = Path(os.path.realpath(path))
    for item in [resolved, *resolved.parents]:
        if below is not None and below != item and below not in item.parents:
            continue
        try:
            info = item.lstat()
        except OSError:
            return f"{item} is not readable"
        if info.st_uid not in trusted_uids:
            return f"{item} is owned by uid {info.st_uid}"
        if info.st_mode & 0o022:
            return f"{item} is group/other writable"
    return None


def sudoers_checks(checks: list[dict[str, Any]], directory: Path = SUDOERS_DIR) -> None:
    """No operator drop-in may grant ALL, shells, interpreters or wildcard escapes."""
    try:
        files = sorted(item for item in directory.iterdir() if item.is_file() and "." not in item.name and not item.name.endswith("~"))
        texts = {item.name: item.read_text() for item in files}
    except OSError:
        return  # unreadable without root; the host check runs as root
    for name, text in texts.items():
        problems = sudoers_findings(parse_sudoers(text))
        message = f"sudoers drop-in {name} has no root-escape entries"
        if not problems:
            add(checks, True, message)
        elif name in SUDOERS_WARN_ONLY:
            add(checks, True, f"WARN: {message}: {SUDOERS_WARN_ONLY[name]}", warn=True, findings=len(problems))
        else:
            add(checks, False, message, findings=problems[:10])


def exec_start_paths(shown: str) -> list[str]:
    """Executable and absolute script path from a `systemctl show -p ExecStart` value."""
    paths = re.findall(r"path=(\S+)", shown)[:1]
    argv = re.search(r"argv\[\]=(.*?) ;", shown)
    words = argv.group(1).split() if argv else []
    if len(words) > 1 and words[1].startswith("/") and os.path.isfile(words[1]):
        paths.append(words[1])
    return paths


def exec_start_checks(checks: list[dict[str, Any]], runner: Callable[[list[str]], Any] = run, trusted_uids: tuple[int, ...] = (0,), below: Path | None = None) -> None:
    """Every argus unit must execute code only from root-owned, non-group-writable trees."""
    try:
        listed = runner(["systemctl", "list-units", "argus-*.service", "--all", "--plain", "--no-legend", "--no-pager"])
    except OSError:
        add(checks, False, "systemd unit listing available")
        return
    units = sorted({line.split()[0] for line in listed.stdout.splitlines() if line.split()})
    for unit in units:
        shown = runner(["systemctl", "show", unit, "-p", "ExecStart", "--value"]).stdout
        paths = exec_start_paths(shown)
        if not paths:
            continue
        problems = [problem for path in paths if (problem := trusted_path_problem(path, trusted_uids, below))]
        add(checks, not problems, f"{unit} ExecStart is under root-owned, non-group-writable paths", problems=problems[:3])


def ghcr_credential_checks(
    checks: list[dict[str, Any]],
    *,
    config: Path = GHCR_CONFIG,
    stamp: Path = GHCR_STAMP,
    online: bool = False,
    now: datetime | None = None,
    fetch: Callable[[str], subprocess.CompletedProcess[str]] | None = None,
    trusted_uids: tuple[int, ...] = (0,),
    below: Path | None = None,
) -> None:
    """ghcr-credential: dedicated read-only registry login, root 0600, ghcr.io only, rotated within 90 days."""
    name = "ghcr-credential"
    try:
        info = config.lstat()
    except FileNotFoundError:
        add(checks, True, f"WARN: {name}: {config} not installed yet (docs/RUNBOOKS/ghcr-token-rotation.md)", warn=True, check=name)
        return
    except OSError:
        add(checks, False, f"{name}: {config} is not readable", check=name)
        return
    mode = stat.S_IMODE(info.st_mode)
    add(checks, stat.S_ISREG(info.st_mode) and info.st_uid in trusted_uids and mode == 0o600,
        f"{name}: config.json is a root-owned regular file with mode 0600", check=name, mode=oct(mode), uid=info.st_uid)
    parent = trusted_path_problem(str(config.parent), trusted_uids, below)
    add(checks, parent is None, f"{name}: config directory is root-owned and not group/other writable", check=name, problem=parent)
    try:
        auths = json.loads(config.read_text()).get("auths", {})
    except (OSError, ValueError, AttributeError):
        add(checks, False, f"{name}: config.json is valid JSON with an auths map", check=name)
        return
    registries = sorted(auths) if isinstance(auths, dict) else []
    add(checks, registries == ["ghcr.io"], f"{name}: auths contains ghcr.io only", check=name, registries=registries)
    current = now or datetime.now(timezone.utc)
    try:
        rotated = datetime.strptime(stamp.read_text().strip(), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (OSError, ValueError):
        add(checks, False, f"{name}: rotation stamp {stamp} is missing or not an ISO UTC timestamp", check=name)
    else:
        age = (current - rotated).days
        base = f"{name}: token age {age}d (warn at {GHCR_WARN_DAYS}d, fail at {GHCR_FAIL_DAYS}d)"
        if age < 0 or age >= GHCR_FAIL_DAYS:
            add(checks, False, base, check=name, ageDays=age)
        elif age >= GHCR_WARN_DAYS:
            add(checks, True, f"WARN: {base}", warn=True, check=name, ageDays=age)
        else:
            add(checks, True, base, check=name, ageDays=age)
    if online and isinstance(auths.get("ghcr.io"), dict):
        ghcr_online_check(checks, auths["ghcr.io"].get("auth", ""), fetch or curl_github_headers)


def curl_github_headers(token: str) -> subprocess.CompletedProcess[str]:
    # The Authorization header goes over stdin (`-H @-`) so the token never appears in `ps`.
    # curl, not urllib: the core boundary policy forbids undeclared network importers.
    return subprocess.run(
        ["curl", "--silent", "--show-error", "--max-time", "15", "--dump-header", "-", "--output", "/dev/null",
         "--header", "@-", "https://api.github.com/user"],
        input=f"Authorization: Bearer {token}\nUser-Agent: argus-doctor\n", text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=30,
    )


def ghcr_online_check(checks: list[dict[str, Any]], auth: str, fetch: Callable[[str], subprocess.CompletedProcess[str]]) -> None:
    name = "ghcr-credential"
    try:
        token = base64.b64decode(auth, validate=True).decode().partition(":")[2]
    except (binascii.Error, UnicodeDecodeError):
        token = ""
    if not token:
        add(checks, False, f"{name}: ghcr.io auth entry is not user:token base64", check=name)
        return
    try:
        result = fetch(token)
    except (OSError, subprocess.TimeoutExpired):
        add(checks, True, f"WARN: {name}: curl or GitHub unavailable; scopes not verified", warn=True, check=name)
        return
    status = re.match(r"HTTP/\S+\s+(\d{3})", result.stdout)
    if result.returncode != 0 or status is None:
        add(checks, True, f"WARN: {name}: GitHub unreachable; scopes not verified", warn=True, check=name)
        return
    if status.group(1) != "200":
        add(checks, False, f"{name}: GitHub rejected the token (HTTP {status.group(1)})", check=name)
        return
    header = re.search(r"^x-oauth-scopes:(.*)$", result.stdout, re.IGNORECASE | re.MULTILINE)
    scopes = {item.strip() for item in (header.group(1) if header else "").split(",") if item.strip()}
    add(checks, scopes == GHCR_SCOPES, f"{name}: token scopes are exactly read:packages", check=name, scopes=sorted(scopes))


def core_boundary_check(checks: list[dict[str, Any]]) -> None:
    command = [str(root() / "scripts" / "argus-check"), "--boundary-only", "--boundary-json"]
    if os.geteuid() == 0:
        # Host mode needs root for service and ownership checks, while the
        # deterministic boundary audit intentionally refuses root.  Run only
        # that read-only audit as the owner of the reviewed checkout.
        try:
            owner = pwd.getpwuid(root().stat().st_uid).pw_name
        except (KeyError, OSError):
            add(checks, False, "deterministic core boundary audit available")
            return
        runuser = shutil.which("runuser")
        if not owner or owner == "root" or runuser is None:
            add(checks, False, "deterministic core boundary audit available")
            return
        command = [runuser, "-u", owner, "--", *command]
    try:
        result = run(command)
    except OSError:
        add(checks, False, "deterministic core boundary audit available")
        return
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        add(checks, False, "deterministic core boundary audit available")
        return
    add(
        checks,
        result.returncode == 0 and payload.get("auditResult") == "pass",
        "deterministic core boundary clean",
        coreBoundaryPolicyVersion=payload.get("policyVersion"),
        coreBoundaryAuditVersion=payload.get("auditVersion"),
        coreBoundaryAuditResult=payload.get("auditResult"),
        dependencySbomDigest=payload.get("sbomDigest"),
        endpointNetworkPolicyDigest=payload.get("endpointDigest"),
    )


def audit(*, include_host: bool = False, online: bool = False) -> dict[str, Any]:
    checks: list[dict[str, Any]] = []
    config_valid(checks)
    argus_quarantine_checks(checks)
    tracked_file_checks(checks)
    exposure_checks(checks)
    cloudflare_ingress_checks(checks)
    reconcile_check(checks)
    if include_host:
        host_health_checks(checks)
        api_service_user_checks(checks)
        sudoers_checks(checks)
        exec_start_checks(checks)
        ghcr_credential_checks(checks, online=online)
    core_boundary_check(checks)
    failures = [check for check in checks if not check["ok"]]
    return {"ok": not failures, "failures": len(failures), "checks": checks}


def print_text(result: dict[str, Any]) -> None:
    for check in result["checks"]:
        print(("warn " if check.get("warn") else "ok   " if check["ok"] else "fail ") + check["message"])


def main() -> int:
    parser = argparse.ArgumentParser(description="Run Argus security and exposure audit checks.")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--host", action="store_true", help="include live host ownership and PostgreSQL checks")
    parser.add_argument("--online", action="store_true", help="with --host: also verify the GHCR token scopes against GitHub")
    args = parser.parse_args()

    result = audit(include_host=args.host, online=args.online)
    if args.json:
        print_json(result)
    else:
        print_text(result)
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
