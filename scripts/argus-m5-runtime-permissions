#!/usr/bin/env bash
# Reconcile the private Phase 1 shared-writer and SQLite ownership boundary.
set -euo pipefail

readonly ROOT="${ARGUS_ROOT:-/srv/argus}"
readonly RUNTIME="$ROOT/runtime/argus/m5"
readonly M1_RUNTIME="$ROOT/runtime/argus/m1"
readonly CONTROL_STATE="/var/lib/argus/control"
readonly CONFIG_DIR="$ROOT/config"
readonly ACCESS_CONFIG="$CONFIG_DIR/access.json"
readonly AUDIT_DATABASE="$ROOT/runtime/argus/audit.sqlite3"
readonly DASHBOARD_PUBLIC="$ROOT/control-plane/dashboard/public"
readonly API_USER="oreo"
readonly WORKER_USER="argus-worker"
readonly CONTROL_GROUP="argus-control"

fail() { printf 'ERROR %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || fail "run with sudo"
getent passwd "$API_USER" >/dev/null || fail "missing API user: $API_USER"
getent passwd "$WORKER_USER" >/dev/null || fail "missing worker user: $WORKER_USER"
getent group "$CONTROL_GROUP" >/dev/null || fail "missing control group: $CONTROL_GROUP"
[[ -f "$ACCESS_CONFIG" ]] || fail "missing access compatibility store"
for output in app.js index.html metrics.json style.css; do
  [[ -f "$DASHBOARD_PUBLIC/$output" ]] ||
    fail "missing generated dashboard output: $output"
done

install -d -m 2770 -o "$API_USER" -g "$CONTROL_GROUP" \
  "$ROOT/runtime/argus" "$M1_RUNTIME" "$CONFIG_DIR"
install -d -m 0770 -o "$API_USER" -g "$CONTROL_GROUP" \
  "$RUNTIME" "$RUNTIME/agents"
install -d -m 0770 -o "$API_USER" -g "$CONTROL_GROUP" "$CONTROL_STATE"
install -d -m 2775 -o "$API_USER" -g "$CONTROL_GROUP" "$DASHBOARD_PUBLIC"

reconciled=0
chown "$API_USER:$CONTROL_GROUP" "$ACCESS_CONFIG"
chmod 0660 "$ACCESS_CONFIG"
reconciled=$((reconciled + 1))

for path in "$M1_RUNTIME/access-journal.jsonl"; do
  [[ -e "$path" ]] || continue
  chown "$API_USER:$CONTROL_GROUP" "$path"
  chmod 0660 "$path"
  reconciled=$((reconciled + 1))
done

for database in "$M1_RUNTIME/state.sqlite3" "$AUDIT_DATABASE"; do
  for suffix in "" -wal -shm; do
    path="$database$suffix"
    [[ -e "$path" ]] || continue
    chown "$API_USER:$CONTROL_GROUP" "$path"
    chmod 0660 "$path"
    reconciled=$((reconciled + 1))
  done
done

for output in app.js index.html metrics.json style.css; do
  path="$DASHBOARD_PUBLIC/$output"
  chown "$API_USER:$CONTROL_GROUP" "$path"
  chmod 0664 "$path"
  reconciled=$((reconciled + 1))
done

for database in operations.sqlite3; do
  for suffix in "" -wal -shm; do
    path="$RUNTIME/$database$suffix"
    [[ -e "$path" ]] || continue
    chown "$API_USER:$CONTROL_GROUP" "$path"
    chmod 0660 "$path"
    reconciled=$((reconciled + 1))
  done
done

for suffix in "" -wal -shm; do
  path="$CONTROL_STATE/operations.sqlite3$suffix"
  [[ -e "$path" ]] || continue
  chown "$WORKER_USER:$CONTROL_GROUP" "$path"
  chmod 0660 "$path"
  reconciled=$((reconciled + 1))
done

for suffix in "" -wal -shm; do
  path="$CONTROL_STATE/session.sqlite3$suffix"
  [[ -e "$path" ]] || continue
  chown "$API_USER:$CONTROL_GROUP" "$path"
  chmod 0600 "$path"
  reconciled=$((reconciled + 1))
done

printf 'M5_RUNTIME_PERMISSIONS_OK files=%d apiOwner=%s workerOwner=%s group=%s operationMode=0660 sessionMode=0600 sharedWriterMode=0660 dashboardMode=0664\n' \
  "$reconciled" "$API_USER" "$WORKER_USER" "$CONTROL_GROUP"
