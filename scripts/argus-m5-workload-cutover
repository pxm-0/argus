ROOT = Path("/srv/argus")
STATE_ROOT = Path("/var/lib/argus/migration-cutovers")
RUNTIME_ROOT = Path("/var/lib/argus/migration-runtime")
# Sealed credential delivery: root-owned, sandbox-group-readable, never a
# /home/oreo bind. Operators provision one directory per workload here.
CREDENTIAL_ROOT = Path("/etc/argus/workload-credentials")
# Egress is a declared protocol: every spec must carry an "egress" key, and
# None means sealed on purpose. Rules are derived from the declaration only,
# never hand-written, so an undeclared workload can never acquire a hole.
# Verified on the host: RootlessKit slirp4netns gives each domain one uplink.
UPLINK_INTERFACE = "tap0"
EGRESS_PROTOCOLS = ("tcp", "udp")
EGRESS_ACK = "--acknowledge-m5-egress-policy"
REFRESH_ACK = "--acknowledge-m5-workload-refresh"
LOCK_PATH = Path("/run/argus-m5-workload-cutover/lock")
UNIX_SOCKET_PATH_LIMIT = 108
APPLY_ACK = "--acknowledge-m5-workload-cutover"
ROLLBACK_ACK = "--acknowledge-m5-workload-cutover-rollback"
STAGE_ACK = "--acknowledge-m5-workload-stage"
QUIESCE_ACK = "--acknowledge-source-writers-stopped"
HANDLED_SIGNALS = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
# Every retained workload has its own 60s reconcile timer but they all share one
# serialization lock, so overlapping firings must queue instead of failing.
# Stays under the oneshot TimeoutStartSec=90s default.
RECONCILE_LOCK_WAIT_SECONDS = 60
# ponytail: ingress_image is not provisioned by any script -- it exists only
# because someone once ran, on the host (which has internet; the sandbox's
# default-deny egress does not):
#   docker pull caddy:2 && docker save caddy:2 -o /tmp/caddy2.tar
#   runuser -u argus-personal-sandbox -- docker --host \
#     unix:///var/lib/argus/personal-sandbox/docker.sock load -i /tmp/caddy2.tar
# then pinned the resulting local image ID here. A personal-sandbox rebuild
# (wiping docker-data) destroys it with no way to recover the exact ID --
# confirmed live 2026-07-30, which is why this digest changed. Repeat the
# steps above and update every "ingress_image" below whenever that happens.
RECONCILE_LOCK_POLL_SECONDS = 0.5
