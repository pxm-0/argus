#!/usr/bin/env python3
from __future__ import annotations

import argparse

from argus_cloudflare_activation import MODES, activation_plan, audit_preview, json_or_text


def main() -> int:
    parser = argparse.ArgumentParser(description="Preview an allowlisted Cloudflare named-tunnel activation (D027).")
    parser.add_argument("workload_id")
    parser.add_argument("--mode", required=True, choices=sorted(MODES), help="protected first; public only after protected evidence.")
    parser.add_argument("--json", action="store_true", help="Print activation preview as JSON.")
    args = parser.parse_args()

    plan = activation_plan(args.workload_id, args.mode)
    audit_preview(plan)
    json_or_text(plan, as_json=args.json)
    return 0 if plan["ok"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
