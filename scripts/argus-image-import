#!/usr/bin/env python3
"""Import one allowlisted image, by digest, into a rootless trust-domain daemon.

Sealed domains deny egress and deploy with ``--pull never``, so the host pulls
the reviewed digest and loads it into the domain over the domain's own socket.
Prints the image ID the domain reports; that ID is what a reviewed Compose file
pins as ``image: sha256:<id>``. Run as root on oreochiserver.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
SOURCES = ROOT / "config" / "argus" / "observation-sources.json"
ALLOWED_IMAGES = (
    re.compile(r"ghcr\.io/pxm-0/[a-z0-9-]+@sha256:[0-9a-f]{64}"),
    re.compile(r"docker\.io/library/caddy@sha256:[0-9a-f]{64}"),
)
IMAGE_ID = re.compile(r"sha256:[0-9a-f]{64}")
DOCKER_TIMEOUT_SECONDS = 900


class ImportFailure(RuntimeError):
    """A precondition or runtime step failed; nothing was pinned."""


def rootless_domains(sources: Path = SOURCES) -> set[str]:
    try:
        registry = json.loads(sources.read_text(encoding="utf-8"))
        return {
            str(source["trustDomain"])
            for source in registry["sources"]
            if str(source["sourceId"]).endswith(".rootless-docker")
        }
    except (OSError, KeyError, TypeError, ValueError) as exc:
        raise ImportFailure("trust-domain registry is unavailable or malformed") from exc


def validate(domain: str, image: str, domains: set[str]) -> None:
    if domain not in domains:
        raise ValueError(f"unknown rootless trust domain: {domain}")
    if not any(pattern.fullmatch(image) for pattern in ALLOWED_IMAGES):
        raise ValueError("image must be an allowlisted reference pinned by sha256 digest")


def domain_docker(domain: str, *arguments: str) -> list[str]:
    return [
        "runuser", "-u", f"argus-{domain}", "--",
        "docker", "--host", f"unix:///var/lib/argus/{domain}/docker.sock",
        *arguments,
    ]


def loaded_reference(output: str) -> str:
    loaded = [
        line.split(":", 1)[1].strip()
        for line in output.splitlines()
        if line.startswith(("Loaded image:", "Loaded image ID:"))
    ]
    if len(loaded) != 1:
        raise ImportFailure("docker load did not report exactly one image")
    return loaded[0]


def import_image(domain: str, image: str) -> str:
    pull = subprocess.run(
        ["docker", "pull", image], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
        text=True, check=False, timeout=DOCKER_TIMEOUT_SECONDS,
    )
    if pull.returncode != 0:
        raise ImportFailure(f"host docker pull failed: {pull.stderr.strip()[-300:]}")
    save = subprocess.Popen(["docker", "save", image], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        load = subprocess.run(
            domain_docker(domain, "load"), stdin=save.stdout, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, check=False, timeout=DOCKER_TIMEOUT_SECONDS,
        )
        save.stdout.close()
        save_error = save.stderr.read().decode(errors="replace")
        save.wait(timeout=DOCKER_TIMEOUT_SECONDS)
    finally:
        if save.poll() is None:
            save.kill()
            save.wait()
        save.stderr.close()
    if save.returncode != 0:
        raise ImportFailure(f"host docker save failed: {save_error.strip()[-300:]}")
    if load.returncode != 0:
        raise ImportFailure(f"domain docker load failed: {load.stderr.strip()[-300:]}")
    inspect = subprocess.run(
        domain_docker(domain, "image", "inspect", "--format", "{{.Id}}", loaded_reference(load.stdout)),
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False, timeout=60,
    )
    image_id = inspect.stdout.strip()
    if inspect.returncode != 0 or not IMAGE_ID.fullmatch(image_id):
        raise ImportFailure("domain did not report a sha256 image ID for the loaded image")
    return image_id


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Import an allowlisted image digest into a rootless trust domain.")
    parser.add_argument("--domain", required=True, help="Rootless trust domain, for example personal-managed.")
    parser.add_argument("--image", required=True, help="Allowlisted reference pinned by @sha256 digest.")
    arguments = parser.parse_args(argv)

    def refuse(code: str, message: str, status: int) -> int:
        print(json.dumps({"ok": False, "error": {"code": code, "message": message}}, sort_keys=True))
        return status

    try:
        validate(arguments.domain, arguments.image, rootless_domains())
    except ValueError as exc:
        return refuse("image-import-invalid", str(exc), 2)
    except ImportFailure as exc:
        return refuse("image-import-unavailable", str(exc), 4)
    if os.geteuid() != 0:
        return refuse("image-import-refused", "argus-image-import must run as root", 3)
    try:
        pwd.getpwnam(f"argus-{arguments.domain}")
    except KeyError:
        return refuse("image-import-refused", f"domain account argus-{arguments.domain} does not exist", 3)
    try:
        image_id = import_image(arguments.domain, arguments.image)
    except (ImportFailure, OSError, subprocess.TimeoutExpired) as exc:
        return refuse("image-import-failed", str(exc), 1)
    print(json.dumps({"ok": True, "domain": arguments.domain, "image": arguments.image, "imageId": image_id}, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
