#!/usr/bin/env python3
"""Dump a sandboxed workload's Postgres through its own rootless daemon.

Host-side `docker compose exec` cannot reach a sealed sandbox, which is how
kadath's nightly backup silently died at cutover (#266). This runs the dump
inside the sandbox and verifies the artifact before keeping it.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tarfile
import time


BACKUP_ROOT = Path("/var/backups/argus-m5-workload-db")
# Retained workloads that carry a database, mapped to their sandbox identity.
SPECS = {
    "kadath": {
        "domain": "personal-sandbox",
        "project": "kadath-live",
        "service": "postgres",
    },
    "intake-os": {
        "domain": "work-sandbox",
        "project": "intake-os",
        "service": "postgres",
    },
}
RETAINED_COPIES = 14
DUMP_TIMEOUT_SECONDS = 900
REPAIR_TIMEOUT_SECONDS = 180
POSTGRES_UID = 999
POSTGRES_GID = 999


class BackupError(RuntimeError):
    pass


def target_command(domain: str, *arguments: str) -> list[str]:
    user = f"argus-{domain}"
    return [
        "runuser",
        "-u",
        user,
        "--",
        "env",
        f"HOME=/home/{user}",
        "docker",
        "--host",
        f"unix:///var/lib/argus/{domain}/docker.sock",
        *arguments,
    ]


def text(command: list[str], timeout: float | None = None) -> str:
    return subprocess.run(
        command,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        timeout=timeout,
    ).stdout


def container_name(spec: dict) -> str:
    names = text(
        [
            *target_command(
                str(spec["domain"]),
                "ps",
                "--format",
                "{{.Names}}",
                "--filter",
                f"label=com.docker.compose.project={spec['project']}",
                "--filter",
                f"label=com.docker.compose.service={spec['service']}",
            )
        ]
    ).split()
    if len(names) != 1:
        raise BackupError(
            f"database container for {spec['project']} is ambiguous or absent"
        )
    return names[0]


def database_mount(spec: dict, container: str) -> dict:
    try:
        mounts = json.loads(
            text(
                [
                    *target_command(
                        str(spec["domain"]),
                        "inspect",
                        "--format={{json .Mounts}}",
                        container,
                    )
                ]
            )
        )
    except (json.JSONDecodeError, TypeError) as error:
        raise BackupError(f"could not inspect database volume for {container}") from error
    matches = [
        mount
        for mount in mounts
        if isinstance(mount, dict)
        and mount.get("Type") == "volume"
        and mount.get("Destination") == "/var/lib/postgresql/data"
    ]
    if len(matches) != 1:
        raise BackupError(
            f"database volume for {container} is absent or ambiguous"
        )
    mount = matches[0]
    volume = mount.get("Name")
    if not isinstance(volume, str) or re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9_.-]*", volume
    ) is None:
        raise BackupError(f"database volume name for {container} is unsafe")
    source = mount.get("Source")
    if not isinstance(source, str) or not source.startswith("/"):
        raise BackupError(f"database volume source for {container} is unsafe")
    return {"name": volume, "source": source}


def database_volume(spec: dict, container: str) -> str:
    return str(database_mount(spec, container)["name"])


def volume_source(spec: dict, container: str) -> Path:
    source = Path(str(database_mount(spec, container)["source"]))
    allowed_root = Path(f"/var/lib/argus/{spec['domain']}/docker-data/volumes")
    try:
        relative = source.relative_to(allowed_root)
    except ValueError as error:
        raise BackupError("database volume source is outside its domain store") from error
    if source.name != "_data" or len(relative.parts) != 2:
        raise BackupError("database volume source is not an exact Docker volume path")
    metadata = os.lstat(source)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise BackupError("database volume source is not a real directory")
    return source


def rootless_host_id(user: str, mapping: Path, container_id: int) -> int:
    if container_id < 1:
        raise BackupError("rootless container IDs must be positive")
    for line in mapping.read_text(encoding="utf-8").splitlines():
        owner, separator, values = line.partition(":")
        if owner != user or not separator:
            continue
        start_text, separator, length_text = values.partition(":")
        if not separator:
            continue
        start, length = int(start_text), int(length_text)
        if container_id <= length:
            return start + container_id - 1
    raise BackupError(f"rootless ID mapping is missing for {user}")


def expected_host_ownership(spec: dict) -> tuple[int, int]:
    user = f"argus-{spec['domain']}"
    return (
        rootless_host_id(user, Path("/etc/subuid"), POSTGRES_UID),
        rootless_host_id(user, Path("/etc/subgid"), POSTGRES_GID),
    )


def volume_entries(source: Path) -> list[Path]:
    entries = [source]
    for directory, child_directories, files in os.walk(source, followlinks=False):
        entries.extend(Path(directory) / name for name in child_directories)
        entries.extend(Path(directory) / name for name in files)
    return entries


def ownership_status(workload: str, container: str | None = None) -> dict:
    spec = SPECS[workload]
    selected_container = container or container_name(spec)
    volume = database_mount(spec, selected_container)["name"]
    source = volume_source(spec, selected_container)
    expected_uid, expected_gid = expected_host_ownership(spec)
    count = 0
    for entry in volume_entries(source):
        metadata = os.lstat(entry)
        if metadata.st_uid != expected_uid or metadata.st_gid != expected_gid:
            count += 1
    return {
        "schemaVersion": 1,
        "workloadId": workload,
        "container": selected_container,
        "volume": volume,
        "expectedUid": POSTGRES_UID,
        "expectedGid": POSTGRES_GID,
        "nonPostgresOwnedEntries": count,
        "ok": count == 0,
    }


def require_owned_volume(workload: str, container: str) -> dict:
    status = ownership_status(workload, container)
    if not status["ok"]:
        raise BackupError(
            f"{workload} database volume ownership mismatch; "
            f"run --action repair-ownership --confirm {workload}"
        )
    return status


def container_state(spec: dict, container: str) -> str:
    return text(
        [
            *target_command(
                str(spec["domain"]),
                "inspect",
                "--format={{.State.Status}}",
                container,
            )
        ]
    ).strip()


def wait_for_state(spec: dict, container: str, states: set[str]) -> str:
    deadline = time.monotonic() + REPAIR_TIMEOUT_SECONDS
    current = "unknown"
    while time.monotonic() < deadline:
        current = container_state(spec, container)
        if current in states:
            return current
        if "running" in states and current in {"exited", "dead"}:
            raise BackupError(f"{container} entered terminal state ({current})")
        time.sleep(1)
    raise BackupError(
        f"{container} did not reach an expected state (last={current})"
    )


def stop_database(spec: dict, container: str) -> None:
    subprocess.run(
        [
            *target_command(
                str(spec["domain"]),
                "stop",
                "--time",
                "60",
                container,
            )
        ],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=REPAIR_TIMEOUT_SECONDS,
    )
    wait_for_state(spec, container, {"exited", "dead"})


def start_database(spec: dict, container: str) -> None:
    subprocess.run(
        [*target_command(str(spec["domain"]), "start", container)],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=REPAIR_TIMEOUT_SECONDS,
    )
    wait_for_state(spec, container, {"running"})


def wait_for_database(spec: dict, container: str, role: str, database: str) -> None:
    deadline = time.monotonic() + REPAIR_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        result = subprocess.run(
            [
                *target_command(
                    str(spec["domain"]),
                    "exec",
                    container,
                    "pg_isready",
                    "-U",
                    role,
                    "-d",
                    database,
                )
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        if result.returncode == 0:
            return
        time.sleep(1)
    raise BackupError(f"{container} PostgreSQL readiness did not recover")


def snapshot_volume(source: Path, destination: Path) -> None:
    partial = destination.with_name(f".{destination.name}.partial")
    descriptor = os.open(
        partial, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600
    )
    try:
        with os.fdopen(descriptor, "wb") as handle:
            with tarfile.open(fileobj=handle, mode="w:gz") as archive:
                archive.add(source, arcname=".", recursive=True)
        with tarfile.open(partial, "r:gz") as archive:
            if archive.next() is None:
                raise BackupError("database volume snapshot is empty")
        os.replace(partial, destination)
        os.chmod(destination, 0o600)
    except BaseException:
        partial.unlink(missing_ok=True)
        raise


def restore_volume(source: Path, archive: Path) -> None:
    subprocess.run(
        [
            "tar",
            "--numeric-owner",
            "--same-owner",
            "-xzf",
            str(archive),
            "-C",
            str(source),
        ],
        check=True,
        stdout=subprocess.DEVNULL,
        timeout=REPAIR_TIMEOUT_SECONDS,
    )


def repair_volume_ownership(spec: dict, source: Path) -> None:
    expected_uid, expected_gid = expected_host_ownership(spec)
    for entry in volume_entries(source):
        os.chown(entry, expected_uid, expected_gid, follow_symlinks=False)


def repair_ownership(workload: str, confirmation: str | None) -> dict:
    if confirmation != workload:
        raise BackupError("repair requires --confirm matching --workload exactly")
    if os.geteuid() != 0:
        raise BackupError("run with sudo")
    spec = SPECS[workload]
    container = container_name(spec)
    role, database = credentials(spec, container)
    before = ownership_status(workload, container)
    source = volume_source(spec, container)
    if before["ok"]:
        return {**before, "changed": False, "verified": True}
    if container_state(spec, container) != "running":
        raise BackupError("refusing repair unless the selected database is running")
    directory = BACKUP_ROOT / workload
    ensure_root_directory(BACKUP_ROOT)
    ensure_root_directory(directory)
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    snapshot = directory / f"{workload}-ownership-{stamp}.tar.gz"
    stopped = False
    try:
        stop_database(spec, container)
        stopped = True
        snapshot_volume(source, snapshot)
        repair_volume_ownership(spec, source)
        after = ownership_status(workload, container)
        if not after["ok"]:
            raise BackupError("database volume ownership repair did not converge")
        start_database(spec, container)
        stopped = False
        wait_for_database(spec, container, role, database)
    except BaseException as error:
        try:
            if container_state(spec, container) == "running":
                stop_database(spec, container)
            if snapshot.exists():
                restore_volume(source, snapshot)
            if stopped or snapshot.exists():
                start_database(spec, container)
        except BaseException as rollback_error:
            raise BackupError(
                "ownership repair failed and snapshot rollback failed"
            ) from rollback_error
        raise error
    return {
        **after,
        "changed": True,
        "verified": True,
        "snapshotPath": str(snapshot),
    }


def credentials(spec: dict, container: str) -> tuple[str, str]:
    """Read role and database from container env, never from a committed file."""
    values = {}
    for entry in text(
        [*target_command(str(spec["domain"]), "exec", container, "printenv")]
    ).splitlines():
        key, separator, value = entry.partition("=")
        if separator:
            values[key] = value
    role = values.get("POSTGRES_USER", "")
    database = values.get("POSTGRES_DB", "")
    if not role or not database:
        raise BackupError(
            f"{container} does not declare POSTGRES_USER and POSTGRES_DB"
        )
    return role, database


def ensure_root_directory(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    metadata = os.lstat(path)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise BackupError(f"unsafe backup directory: {path}")
    os.chown(path, 0, 0)
    os.chmod(path, 0o700)


def prune(directory: Path, keep: int) -> list[str]:
    dumps = sorted(
        (item for item in directory.iterdir() if item.suffix == ".dump"),
        reverse=True,
    )
    removed = []
    for stale in dumps[keep:]:
        stale.unlink()
        removed.append(stale.name)
    return removed


def backup(workload: str) -> dict:
    if os.geteuid() != 0:
        raise BackupError("run with sudo")
    spec = SPECS[workload]
    directory = BACKUP_ROOT / workload
    ensure_root_directory(BACKUP_ROOT)
    ensure_root_directory(directory)
    container = container_name(spec)
    role, database = credentials(spec, container)
    require_owned_volume(workload, container)
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    artifact = directory / f"{workload}-{stamp}.dump"
    partial = directory / f".{artifact.name}.partial"
    descriptor = os.open(
        partial, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600
    )
    try:
        with os.fdopen(descriptor, "wb") as handle:
            subprocess.run(
                [
                    *target_command(
                        str(spec["domain"]),
                        "exec",
                        container,
                        "pg_dump",
                        "-U",
                        role,
                        "-d",
                        database,
                        "-Fc",
                    )
                ],
                check=True,
                stdout=handle,
                timeout=DUMP_TIMEOUT_SECONDS,
            )
        # An unverified dump is not a backup: prove the artifact is readable
        # before it is allowed to count as the night's copy.
        with open(partial, "rb") as handle:
            subprocess.run(
                [
                    *target_command(
                        str(spec["domain"]),
                        "exec",
                        # docker exec gives the container /dev/null on stdin
                        # unless -i is passed, so the dump must be piped in
                        # explicitly or pg_restore reads an empty file and the
                        # verification fails on a good artifact.
                        "-i",
                        container,
                        "pg_restore",
                        "--list",
                    )
                ],
                check=True,
                stdin=handle,
                stdout=subprocess.DEVNULL,
                timeout=DUMP_TIMEOUT_SECONDS,
            )
    except BaseException:
        partial.unlink(missing_ok=True)
        raise
    if partial.exists():
        os.replace(partial, artifact)
    size = artifact.stat().st_size
    if size == 0:
        artifact.unlink()
        raise BackupError("dump verified but empty")
    return {
        "schemaVersion": 1,
        "workloadId": workload,
        "trustDomain": spec["domain"],
        "container": container,
        "artifactPath": str(artifact),
        "artifactBytes": size,
        "verified": True,
        "prunedCopies": prune(directory, RETAINED_COPIES),
        "retainedCopies": RETAINED_COPIES,
        "completedAt": stamp,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workload", required=True, choices=sorted(SPECS))
    parser.add_argument(
        "--action",
        choices=("backup", "check-ownership", "repair-ownership"),
        default="backup",
    )
    parser.add_argument(
        "--confirm",
        help="exact workload ID required for ownership repair",
    )
    arguments = parser.parse_args()
    if arguments.action == "check-ownership":
        result = ownership_status(arguments.workload)
        print(json.dumps(result, sort_keys=True))
        return 0 if result["ok"] else 1
    if arguments.action == "repair-ownership":
        result = repair_ownership(arguments.workload, arguments.confirm)
    else:
        result = backup(arguments.workload)
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (BackupError, subprocess.SubprocessError, OSError) as error:
        print(f"{type(error).__name__}: {error}", file=sys.stderr)
        raise SystemExit(1) from error
