#!/usr/bin/env python3
"""Back up hastur's data and credentials.

Hastur runs rootful, outside the sandbox (see docs/HANDOFF notes on the
2026-07-30 outage), so its data is plain host directories, not a database
behind a sandboxed daemon. This has no backup today — the same silent-failure
class as #266 (kadath's orphaned nightly dump), just simpler to fix because
there is no docker exec or sandbox socket involved: it's a tar of two paths.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time


BACKUP_ROOT = Path("/var/backups/argus-m5-workload-files")
SPECS = {
    "hastur": {
        "data": Path("/home/oreo/hastur/data"),
        "auth": Path("/home/oreo/hastur/auth"),
    },
}
RETAINED_COPIES = 14

PULL_DIR = Path("/var/backups/argus-snapshots-pull")
PULL_OWNER = "oreo"
RECIPIENT_RE = re.compile(r"^(age1[a-z0-9]+|ssh-(ed25519|rsa) \S+.*)$")


def copy_nofollow(source: Path, partial: Path, mode: int, uid: int | None, gid: int | None) -> None:
    """Write partial as a fresh file in an oreo-writable dir: never follow a planted symlink, never reuse a file."""
    partial.unlink(missing_ok=True)
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, "wb") as out, source.open("rb") as handle:
        if uid is not None:
            os.fchown(out.fileno(), uid, gid)
        os.fchmod(out.fileno(), mode)
        shutil.copyfileobj(handle, out)


def publish_encrypted(artifact: Path, recipient_file: Path, pull_dir: Path, prefix: str, keep: int) -> dict:
    """Encrypt an already-verified artifact to public keys, then atomically publish it to the pull dir."""
    lines = [ln.strip() for ln in recipient_file.read_text().splitlines() if ln.strip() and not ln.startswith("#")]
    if not lines or any(not RECIPIENT_RE.match(ln) for ln in lines):
        raise BackupError("recipient file must contain only age/ssh public keys")
    ids = pwd.getpwnam(PULL_OWNER)
    pull_dir.mkdir(parents=True, exist_ok=True)
    os.chown(pull_dir, ids.pw_uid, ids.pw_gid)
    os.chmod(pull_dir, 0o750)
    final = pull_dir / f"{artifact.name}.age"
    partial = pull_dir / f".{final.name}.partial"
    # encrypt in a root-only temp dir, then copy into the oreo-writable pull dir without following symlinks
    with tempfile.TemporaryDirectory(prefix="argus-age-") as work:
        encrypted = Path(work) / final.name
        proc = subprocess.run(["age", "-R", str(recipient_file), "-o", str(encrypted), str(artifact)],
                              capture_output=True, check=False)
        if proc.returncode != 0 or not encrypted.exists() or encrypted.stat().st_size == 0:
            raise BackupError("age encryption failed")
        try:
            copy_nofollow(encrypted, partial, 0o640, ids.pw_uid, ids.pw_gid)
            os.replace(partial, final)
        finally:
            partial.unlink(missing_ok=True)
    stale = sorted(pull_dir.glob(f"{prefix}-*.age"), reverse=True)[keep:]
    for path in stale:
        path.unlink()
    return {"path": str(final), "bytes": final.stat().st_size, "pruned": [p.name for p in stale]}


class BackupError(RuntimeError):
    pass


def ensure_root_directory(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    metadata = os.lstat(path)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise BackupError(f"unsafe backup directory: {path}")
    os.chown(path, 0, 0)
    os.chmod(path, 0o700)


def prune(directory: Path, keep: int) -> list[str]:
    archives = sorted(
        (item for item in directory.iterdir() if item.suffixes[-2:] == [".tar", ".gz"]),
        reverse=True,
    )
    removed = []
    for stale in archives[keep:]:
        stale.unlink()
        removed.append(stale.name)
    return removed


def archive_one(source: Path, directory: Path, name: str, stamp: str) -> dict:
    if not source.exists():
        raise BackupError(f"source path missing: {source}")
    artifact = directory / f"{name}-{stamp}.tar.gz"
    partial = directory / f".{artifact.name}.partial"
    descriptor = os.open(
        partial, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600
    )
    try:
        with os.fdopen(descriptor, "wb"):
            pass
        with tarfile.open(partial, "w:gz") as tar:
            tar.add(source, arcname=name)
        # An unlistable tar is not a backup: prove it before it counts.
        with tarfile.open(partial, "r:gz") as tar:
            if not tar.getmembers():
                raise BackupError(f"{name} archive verified empty")
    except BaseException:
        partial.unlink(missing_ok=True)
        raise
    os.replace(partial, artifact)
    return {"name": name, "artifactPath": str(artifact), "artifactBytes": artifact.stat().st_size}


def backup(workload: str, recipient_file: Path | None = None) -> dict:
    if os.geteuid() != 0:
        raise BackupError("run with sudo")
    spec = SPECS[workload]
    directory = BACKUP_ROOT / workload
    ensure_root_directory(BACKUP_ROOT)
    ensure_root_directory(directory)
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    artifacts = [archive_one(source, directory, name, stamp) for name, source in spec.items()]
    # hastur is frozen: the pull dir holds exactly one encrypted copy of each archive.
    if recipient_file:
        for item in artifacts:
            item["encryptedCopy"] = publish_encrypted(
                Path(item["artifactPath"]), recipient_file, PULL_DIR, item["name"], 1
            )
    return {
        "schemaVersion": 1,
        "workloadId": workload,
        "artifacts": artifacts,
        "verified": True,
        "prunedCopies": prune(directory, RETAINED_COPIES),
        "retainedCopies": RETAINED_COPIES,
        "completedAt": stamp,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workload", required=True, choices=sorted(SPECS))
    parser.add_argument(
        "--age-recipient-file",
        type=Path,
        help="age public keys; also publish one encrypted copy of each archive to the pull dir",
    )
    arguments = parser.parse_args()
    print(json.dumps(backup(arguments.workload, arguments.age_recipient_file), sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (BackupError, subprocess.SubprocessError, OSError) as error:
        print(f"{type(error).__name__}: {error}", file=sys.stderr)
        raise SystemExit(1) from error
