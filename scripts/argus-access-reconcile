#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

from argus_cloudflare_allowlist import effective_blockers, is_allowlisted, load_evidence
from argus_common import http_status, load_json, print_json, root


SAFE_CLOUDFLARE_PRIVACY = {"unclassified", "personal", "internal"}


def workload_map() -> dict[str, dict[str, Any]]:
    return {str(item.get("id")): item for item in load_json("workloads.json").get("workloads", [])}


def privacy_for(workload_id: str) -> str:
    data = load_json("privacy.json")
    return str(data.get("workloads", {}).get(workload_id, {}).get("privacy", data.get("defaultPrivacy", "")))


def add(findings: list[dict[str, Any]], level: str, workload_id: str, message: str, **extra: Any) -> None:
    findings.append({"level": level, "workloadId": workload_id, "message": message, **extra})


ROUTE_MODES = {"cloudflare-protected": "protected", "cloudflare-public": "public"}


def reconcile(*, offline: bool = False) -> dict[str, Any]:
    access = load_json("access.json")
    routes = load_json("routes.json")
    exposure = load_json("exposure.json")
    workloads = workload_map()
    evidence = load_evidence(root() / "runtime" / "cloudflare-activation")
    findings: list[dict[str, Any]] = []

    observed_funnel = bool(routes.get("observed", {}).get("funnel", {}).get("enabled")) or bool(
        exposure.get("providers", {}).get("tailscale", {}).get("funnel", {}).get("observedEnabled")
    )
    if observed_funnel:
        add(findings, "fail", "tailscale", "tracked config still reports Tailscale Funnel enabled")

    for workload_id, item in access.get("workloads", {}).items():
        desired = str(item.get("desired", ""))
        effective = str(item.get("effective", ""))
        route = routes.get("workloadRoutes", {}).get(workload_id, {})
        cloudflare = route.get("cloudflare", {})
        tailnet = route.get("tailnet", {})
        workload = workloads.get(workload_id, {})
        privacy = privacy_for(workload_id)

        hostname = str(cloudflare.get("hostname", ""))
        if "cloudflare-public" in {desired, effective} and not is_allowlisted(exposure, workload_id, hostname):
            add(findings, "fail", workload_id, "cloudflare-public is allowed only for allowlisted routes")
        if workload.get("kind") == "admin-tool" and effective.startswith("cloudflare"):
            add(findings, "fail", workload_id, "admin tool cannot have Cloudflare effective access")
        if privacy not in SAFE_CLOUDFLARE_PRIVACY and effective.startswith("cloudflare"):
            add(findings, "fail", workload_id, f"{privacy} workload cannot have Cloudflare effective access")

        if effective.startswith("cloudflare"):
            mode = ROUTE_MODES.get(effective, "")
            accepted_modes = {mode}
            # D027 step 2: the route is switched to public while still effective protected, before --mode public runs.
            if effective == "cloudflare-protected" and desired == "cloudflare-public" and is_allowlisted(exposure, workload_id, hostname):
                accepted_modes.add("public")
            if not bool(cloudflare.get("enabled")):
                add(findings, "fail", workload_id, f"effective {effective} but route is disabled")
            if cloudflare.get("mode") not in accepted_modes:
                add(findings, "fail", workload_id, f"effective {effective} but route mode is not {mode or 'known'}")
            if hostname.endswith(".invalid") or not hostname:
                add(findings, "fail", workload_id, f"effective {effective} without a real hostname")
            if effective == "cloudflare-public" and cloudflare.get("requiresAuth") is not False:
                add(findings, "fail", workload_id, "effective cloudflare-public but route still requires auth")
            for blocker in effective_blockers(exposure, workload_id, hostname, effective, evidence):
                add(findings, "fail", workload_id, f"effective {effective}: {blocker}")

        # D027 step 1: an allowlisted route is staged protected before activation makes it effective.
        staged = desired == "cloudflare-protected" and cloudflare.get("mode") == "protected" and is_allowlisted(exposure, workload_id, hostname)
        if effective in {"local", "tailnet", "none"} and bool(cloudflare.get("enabled")) and cloudflare.get("mode") in set(ROUTE_MODES.values()) and not staged:
            add(findings, "fail", workload_id, "Cloudflare route enabled while effective access is not Cloudflare")

        if effective == "tailnet" and not bool(tailnet.get("enabled")):
            add(findings, "fail", workload_id, "effective tailnet but tailnet route is disabled")

        local_url = str(item.get("urls", {}).get("local", ""))
        if local_url and effective in {"local", "tailnet"}:
            if offline:
                add(findings, "warn", workload_id, "local probe skipped in offline mode", url=local_url)
            else:
                status, reason = http_status(local_url)
                if status == "fail":
                    add(findings, "warn", workload_id, "local probe failed", url=local_url, reason=reason)
                else:
                    add(findings, "ok", workload_id, "local probe completed", url=local_url, status=status)

        if desired in ROUTE_MODES and effective != desired:
            add(findings, "ok", workload_id, f"desired {desired} remains planned until verified activation")

    failures = [item for item in findings if item["level"] == "fail"]
    return {
        "ok": not failures,
        "offline": offline,
        "failures": len(failures),
        "warnings": len([item for item in findings if item["level"] == "warn"]),
        "findings": findings,
    }


def rollback_commands(result: dict[str, Any]) -> list[str]:
    """D028: reconcile never relabels state. A failing Cloudflare effective is cut by the rollback script."""
    access = load_json("access.json")
    failing = sorted({
        str(finding["workloadId"])
        for finding in result["findings"]
        if finding["level"] == "fail"
        and str(access.get("workloads", {}).get(str(finding["workloadId"]), {}).get("effective", "")).startswith("cloudflare")
    })
    return [f"sudo scripts/argus-cloudflare-rollback {workload_id} --apply --confirm-workload {workload_id}" for workload_id in failing]


def print_text(result: dict[str, Any]) -> None:
    state = "clean" if result["ok"] else "drift detected"
    print(f"Effective access reconcile: {state}")
    for finding in result["findings"]:
        print(f"{finding['level'].upper()} {finding['workloadId']}: {finding['message']}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Detect desired/effective access drift.")
    parser.add_argument("--apply", action="store_true", help="Print the rollback command for each drifted Cloudflare workload; changes nothing.")
    parser.add_argument("--offline", action="store_true", help="Skip live HTTP probes.")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    result = reconcile(offline=args.offline)
    if args.apply:
        result["rollbackCommands"] = rollback_commands(result)
    if args.json:
        print_json(result)
    else:
        print_text(result)
        for command in result.get("rollbackCommands", []):
            print(f"Run: {command}")
    return 0 if result["ok"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
