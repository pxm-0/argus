#!/usr/bin/env python3
"""Checksum-verify and extract a workload backup into an isolated recovery root."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import tarfile
import tempfile
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workload", required=True)
    parser.add_argument("--artifact-id", required=True)
    parser.add_argument("--acknowledge-isolated-restore", action="store_true")
    args = parser.parse_args()
    if not args.acknowledge_isolated_restore:
        parser.error("isolated restore acknowledgement required")
    if "/" in args.workload or "/" in args.artifact_id or args.artifact_id in {".", ".."}:
        raise SystemExit("invalid workload or artifact id")
    artifact = Path(f"/srv/argus/runtime/backups/{args.workload}/{args.artifact_id}")
    root = Path(os.environ.get("ARGUS_RESTORE_STATE", f"/var/lib/argus/{args.workload}/restore-operations"))
    target = root / args.artifact_id / "candidate"
    marker = target.parent / "verified.json"
    if marker.is_file():
        print(marker.read_text(), end="")
        return 0
    checksums = artifact / "checksums.sha256"
    archive = artifact / "files.tar.gz"
    if not checksums.is_file() or not archive.is_file():
        raise SystemExit("backup artifact is incomplete")
    verified: set[str] = set()
    for row in checksums.read_text().splitlines():
        expected, separator, name = row.partition("  ")
        path = (artifact / name).resolve()
        if not separator or artifact.resolve() not in path.parents or not path.is_file():
            raise SystemExit("unsafe checksum manifest")
        if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise SystemExit("backup checksum mismatch")
        verified.add(name)
    if "files.tar.gz" not in verified:
        raise SystemExit("archive is not checksum verified")
    summary = json.loads((artifact / "backup-summary.json").read_text())
    if summary.get("workloadId") != args.workload:
        raise SystemExit("backup workload identity mismatch")
    target.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=".candidate.", dir=target.parent))
    try:
        with tarfile.open(archive, "r:gz") as bundle:
            for member in bundle.getmembers():
                destination = (staging / member.name).resolve()
                if staging.resolve() != destination and staging.resolve() not in destination.parents:
                    raise SystemExit("archive traversal refused")
                if member.issym() or member.islnk() or member.isdev():
                    raise SystemExit("archive link/device refused")
            bundle.extractall(staging, filter="data")
        os.replace(staging, target)
    finally:
        if staging.exists():
            shutil.rmtree(staging)
    payload = {
        "summary": "Checksum-verified backup restored into an isolated recovery candidate; live state was unchanged.",
        "artifactId": args.artifact_id,
        "liveStateChanged": False,
        "verified": True,
    }
    marker.write_text(json.dumps(payload, sort_keys=True) + "\n")
    os.chmod(marker, 0o600)
    print(marker.read_text(), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
