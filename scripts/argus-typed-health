#!/usr/bin/env python3
"""Periodic typed health.refresh for Argus-managed workloads.

Runs as the dedicated non-human observer identity: it exchanges its own token for
a session (never the owner bootstrap token), creates and approves one
health.refresh operation per eligible workload through the control API, waits for
the terminal state, writes a `health.observed` audit line and exits non-zero when
any workload is not healthy. hastur, kadath and nodens stay on the M5 timers.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path
from typing import Any, Callable

sys.path.insert(0, str(Path(__file__).resolve().parent))

from argus_api_client import TERMINAL_STATES, ApiClient, ApiResponse, ApiUnavailable  # noqa: E402
from argus_common import audit, root  # noqa: E402

OBSERVER_LOGIN = "argus-observer@machine.argus"
EXCLUDED_WORKLOADS = frozenset({"hastur", "kadath", "nodens"})
LEGACY_DOMAIN = "legacy-rootful"
OPERATION_TYPE = "health.refresh"
PROXY_PREFIX = "ARGUS_OPERATOR_PROXY_TOKEN="
POLL_SECONDS = 2.0
OPERATION_DEADLINE_SECONDS = 90.0
DEFAULT_BASE_URL = "http://127.0.0.1:8099"
EXIT_UNHEALTHY = 1
EXIT_SETUP = 2


class SetupError(Exception):
    """Credentials, origin or session exchange unusable; carries no secret."""


class ObserverClient(ApiClient):
    """ApiClient that presents the trusted-proxy identity headers on every request."""

    def __init__(self, base_url: str, *, origin: str, login: str, proxy_token: str) -> None:
        super().__init__(base_url)
        self._identity = {"Origin": origin, "X-Argus-Tailnet-Login": login, "X-Argus-Proxy-Token": proxy_token}

    def request(self, method: str, path: str, body: dict[str, Any] | None = None, *, headers: dict[str, str] | None = None) -> ApiResponse:
        return super().request(method, path, body, headers={**self._identity, **(headers or {})})


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def typed_targets(repo: Path) -> list[str]:
    """Active workloads in a non-legacy domain whose manifest allows health; the M5-timer trio is excluded."""
    classified = read_json(repo / "config" / "argus" / "workload-classification.json").get("workloads", {})
    targets = []
    for item in read_json(repo / "config" / "workloads.json").get("workloads", []):
        workload_id = str(item.get("id", ""))
        if not workload_id or workload_id in EXCLUDED_WORKLOADS or item.get("lifecycle") != "active":
            continue
        manifest = read_json(repo / "workloads" / workload_id / "manifest.json")
        entry = classified.get(workload_id) if isinstance(classified, dict) else None
        domain = str(entry.get("trustDomain") or LEGACY_DOMAIN) if isinstance(entry, dict) else LEGACY_DOMAIN
        domain = str((manifest.get("migration") or {}).get("runtimeTrustDomain") or domain)
        health = (manifest.get("operations") or {}).get("health")
        if domain != LEGACY_DOMAIN and isinstance(health, dict) and health.get("allowed") is True:
            targets.append(workload_id)
    return sorted(targets)


def read_credential(name: str, env_var: str, default: str) -> str:
    directory = os.environ.get("CREDENTIALS_DIRECTORY", "")
    path = Path(directory) / name if directory else Path(os.environ.get(env_var, default))
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        raise SetupError(f"credential {name} is unreadable") from None
    value = value.removeprefix(PROXY_PREFIX).strip()
    if not value:
        raise SetupError(f"credential {name} is empty")
    return value


def operator_origin(repo: Path) -> str:
    configured = os.environ.get("ARGUS_OPERATOR_ORIGIN", "").strip()
    if configured:
        return configured
    origin = str((read_json(repo / "config" / "routes.json").get("dashboard") or {}).get("url", "")).rstrip("/")
    if not origin:
        raise SetupError("operator origin is not configured")
    return origin


def observe(
    client: ApiClient,
    workload_id: str,
    *,
    sleep: Callable[[float], None] = time.sleep,
    clock: Callable[[], float] = time.monotonic,
    deadline_seconds: float = OPERATION_DEADLINE_SECONDS,
) -> dict[str, Any]:
    """Run one typed health.refresh; the result is never raised, only classified."""
    outcome: dict[str, Any] = {"workloadId": workload_id, "status": "error", "operationId": "", "detail": ""}
    try:
        preview = client.preview(workload_id, OPERATION_TYPE, {})
        if preview.status != 200 or preview.body.get("allowed") is not True:
            outcome.update(status="denied", detail=str(preview.body.get("reason") or preview.body.get("error") or f"http-{preview.status}")[:200])
            return outcome
        created = client.create(workload_id, OPERATION_TYPE, {}, preview.body)
        operation_id = str(created.body.get("operation_id", ""))
        if created.status not in (200, 201, 202) or not operation_id:
            outcome.update(status="denied", detail=f"create-http-{created.status}")
            return outcome
        outcome["operationId"] = operation_id
        approved = client.approve(operation_id, str(preview.body.get("confirmationPhrase", "")))
        if approved.status not in (200, 202):
            outcome.update(status="denied", detail=f"approve-http-{approved.status}")
            return outcome
        deadline = clock() + deadline_seconds
        while True:
            operation = client.operation(operation_id).body
            state = str(operation.get("state", ""))
            if state in TERMINAL_STATES:
                break
            if clock() >= deadline:
                outcome.update(status="timeout", detail=f"still {state or 'unknown'}")
                return outcome
            sleep(POLL_SECONDS)
    except ApiUnavailable as exc:
        outcome.update(status="unreachable", detail=str(exc)[:200])
        return outcome
    reported = (operation.get("redactedResult") or {}).get("health") or {}
    healthy = state == "succeeded" and reported.get("ok") is True
    outcome.update(
        status="healthy" if healthy else "unhealthy",
        detail=str(reported.get("detail") or operation.get("redacted_summary") or state)[:200],
        state=state,
    )
    return outcome


def run(client: ApiClient, targets: list[str], **kwargs: Any) -> list[dict[str, Any]]:
    results = []
    for workload_id in targets:
        outcome = observe(client, workload_id, **kwargs)
        audit(
            "health.observed",
            workload_id,
            "ok" if outcome["status"] == "healthy" else "failed",
            actor=OBSERVER_LOGIN,
            status=outcome["status"],
            operationId=outcome["operationId"],
            detail=outcome["detail"],
        )
        results.append(outcome)
    return results


def connect(repo: Path, base_url: str) -> ObserverClient:
    client = ObserverClient(
        base_url,
        origin=operator_origin(repo),
        login=OBSERVER_LOGIN,
        proxy_token=read_credential("operator-proxy-token", "ARGUS_PROXY_TOKEN_FILE", "/etc/argus/operator-proxy-token"),
    )
    token = read_credential("observer-token", "ARGUS_OBSERVER_TOKEN_FILE", "/etc/argus/observer-token")
    try:
        status = client.exchange(token).status
    except ApiUnavailable as exc:
        raise SetupError(str(exc)) from None
    finally:
        token = ""
    if status != 201:
        raise SetupError(f"observer session exchange was refused (HTTP {status}); is the identity allowlisted?")
    return client


def main() -> int:
    parser = argparse.ArgumentParser(description="Refresh typed workload health through the control API.")
    parser.add_argument("--base-url", default=os.environ.get("ARGUS_API_URL", DEFAULT_BASE_URL))
    args = parser.parse_args()
    repo = root()
    targets = typed_targets(repo)
    if not targets:
        print("argus-typed-health: no eligible typed workloads")
        return 0
    try:
        client = connect(repo, args.base_url)
    except (SetupError, ValueError) as exc:
        print(f"argus-typed-health: setup failed: {exc}", file=sys.stderr)
        return EXIT_SETUP
    results = run(client, targets)
    for outcome in results:
        print(f"{outcome['workloadId']}: {outcome['status']} {outcome['detail']}".rstrip())
    return 0 if all(item["status"] == "healthy" for item in results) else EXIT_UNHEALTHY


if __name__ == "__main__":
    raise SystemExit(main())
