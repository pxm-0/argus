#!/usr/bin/env python3
"""Run three-run fixture or live acceptance for D3 schedule sources."""

from __future__ import annotations

import argparse
import json
import os
import platform
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

from argus_collectors import CollectorScheduler, PageValidator, collection_request
from argus_observations import ObservationError, ObservationRepository, digest, load_registry
from argus_systemd_schedule_collector import build_pages, collect_records


ROOT = Path(__file__).resolve().parents[1]
SOURCE_IDS = (
    "oreochiserver.system-schedules",
    "oreochiserver.user-schedules-oreo",
    "oreochiserver.user-schedules-personal-sandbox",
    "oreochiserver.user-schedules-work-sandbox",
)


class FixtureCommandRunner:
    def __init__(self, fixture: dict[str, Any], source_id: str):
        self.fixture = fixture
        self.source_id = source_id
        if source_id == SOURCE_IDS[0]:
            self.payload = fixture["system"]
        else:
            account = source_id.removeprefix("oreochiserver.user-schedules-")
            self.payload = fixture["users"][account]

    def __call__(self, argv: list[str], **_kwargs: Any) -> subprocess.CompletedProcess[bytes]:
        if "list-unit-files" in argv:
            lines = [
                f"{item['unit']} {'enabled' if item['enabled'] else 'disabled'} static"
                for item in self.payload["services"]
            ]
            return subprocess.CompletedProcess(argv, 0, ("\n".join(lines) + "\n").encode(), b"")
        if "list-units" in argv:
            lines = [
                f"{item['unit']} {item['loadState']} {item['activeState']} {item['subState']} fixture"
                for item in self.payload["services"]
            ]
            return subprocess.CompletedProcess(argv, 0, ("\n".join(lines) + "\n").encode(), b"")
        if "list-timers" in argv:
            lines = [
                f"n/a n/a n/a n/a {item['unit']} {item['activates']}"
                for item in self.payload["timers"]
            ]
            return subprocess.CompletedProcess(argv, 0, ("\n".join(lines) + "\n").encode(), b"")
        if argv[:2] == ["crontab", "-l"]:
            text = self.payload.get("crontab", "")
            if text:
                return subprocess.CompletedProcess(argv, 0, text.encode(), b"")
            return subprocess.CompletedProcess(argv, 1, b"", b"no crontab for fixture-user\n")
        raise AssertionError(f"unexpected fixture command: {argv}")


def _fixture_root(fixture: dict[str, Any], directory: Path) -> None:
    system_root = directory / "etc"
    for name in ("cron.d", "cron.daily", "cron.hourly", "cron.weekly", "cron.monthly"):
        (system_root / name).mkdir(parents=True)
    for item in fixture["system"]["cronFiles"]:
        path = system_root / item["directory"] / item["entryName"]
        path.write_text(item["content"], encoding="utf-8")
        path.chmod(item["mode"])


def _source_measurement(records: list[dict[str, Any]]) -> dict[str, Any]:
    return {
        "counts": {
            kind: sum(item["resourceKind"] == kind for item in records)
            for kind in ("systemd-service", "systemd-timer", "cron-entry", "cron-directory")
        },
        "legacyReferences": sum(item["attributes"].get("legacyReference", False) for item in records),
        "snapshotDigest": digest(records),
    }


def fixture_once(root: Path, explicit_clock: str) -> dict[str, Any]:
    registry = load_registry(root / "config/argus/observation-sources.json", root)
    fixture = json.loads((root / "tests/fixtures/schedules/d3-systemd-schedule.json").read_text(encoding="utf-8"))
    with tempfile.TemporaryDirectory(prefix="argus-d3-fixture-", dir="/tmp") as directory:
        fixture_root = Path(directory)
        _fixture_root(fixture, fixture_root)
        measurements: dict[str, Any] = {}
        for source_id in SOURCE_IDS:
            source = registry.sources[source_id]
            request = collection_request(
                source,
                refresh_id="d3-fixture-acceptance",
                run_id=f"d3-fixture-{source_id}",
                explicit_clock=explicit_clock,
            )
            records = collect_records(source, request, runner=FixtureCommandRunner(fixture, source_id), root=fixture_root)
            validator = PageValidator(source, request)
            result = None
            for page in build_pages(source, request, records):
                result = validator.accept(page) or result
            validator.finish()
            if result is None or result.state != "completed" or result.records != records:
                raise ObservationError("D3 fixture stream did not complete")
            measurements[source_id] = _source_measurement(records)
    return measurements


def live_once(root: Path, explicit_clock: str) -> dict[str, Any]:
    registry = load_registry(root / "config/argus/observation-sources.json", root)
    with tempfile.TemporaryDirectory(prefix="argus-d3-live-", dir="/tmp") as directory:
        with ObservationRepository(Path(directory) / "observations.sqlite3") as repository:
            result = CollectorScheduler(
                repository,
                registry,
                max_workers=4,
                global_timeout_milliseconds=30_000,
            ).refresh(refresh_id="d3-live-acceptance", explicit_clock=explicit_clock)
            if result["status"] != "completed" or any(
                item["state"] != "completed" for item in result["sources"]
            ):
                raise ObservationError("D3 schedule collectors did not complete")
            measurements = {
                source_id: _source_measurement(repository.current_snapshot(source_id))
                for source_id in SOURCE_IDS
            }
    measurements["resultDigest"] = digest(result)
    return measurements


def validate_measurements(measurements: list[dict[str, Any]]) -> None:
    if len({digest(item) for item in measurements}) != 1:
        raise ObservationError("repeated D3 schedule evidence differs")


def main() -> int:
    parser = argparse.ArgumentParser(description="Run D3 systemd and schedule collector acceptance")
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument("--source-revision", required=True)
    parser.add_argument("--captured-at", required=True)
    parser.add_argument("--target", choices=("local-ci", "oreochiserver"), required=True)
    args = parser.parse_args()
    try:
        if not args.source_revision or any(character not in "0123456789abcdef" for character in args.source_revision):
            raise ObservationError("source revision must be hexadecimal")
        if args.target == "oreochiserver":
            if platform.node().split(".", 1)[0] != "oreochiserver":
                raise ObservationError("live D3 acceptance must run on oreochiserver")
            revision = subprocess.run(
                ["git", "-C", str(args.root), "rev-parse", "HEAD"],
                text=True,
                capture_output=True,
                check=True,
            ).stdout.strip()
            clean = not subprocess.run(
                ["git", "-C", str(args.root), "status", "--porcelain", "--untracked-files=all"],
                text=True,
                capture_output=True,
                check=True,
            ).stdout
            if revision != args.source_revision or not clean:
                raise ObservationError("live acceptance checkout must match the clean source revision")
            if os.geteuid() != 1000 or os.getegid() != 981:
                raise ObservationError("live D3 acceptance must run as the pinned collector client")
            runner = live_once
        else:
            runner = fixture_once
        measurements = []
        runs = []
        for ordinal in range(1, 4):
            started = time.monotonic_ns()
            measurements.append(runner(args.root, args.captured_at))
            runs.append({
                "ordinal": ordinal,
                "result": "pass",
                "durationMs": (time.monotonic_ns() - started) // 1_000_000,
                "reasonCode": "",
            })
        validate_measurements(measurements)
        evidence_id = digest({
            "checkId": "d3-systemd-schedule-collectors",
            "measurements": measurements,
            "sourceRevision": args.source_revision,
            "target": args.target,
        })
        print("MEASUREMENT " + json.dumps(measurements[0], sort_keys=True, separators=(",", ":")), file=sys.stderr)
        print(json.dumps({
            "schemaVersion": 1,
            "issueId": 323,
            "phase": "post",
            "target": args.target,
            "checkId": "d3-systemd-schedule-collectors",
            "expectedRuns": 3,
            "sourceRevision": args.source_revision,
            "capturedAt": args.captured_at,
            "evidenceId": evidence_id,
            "runs": runs,
        }, sort_keys=True, separators=(",", ":")))
    except (ObservationError, OSError, ValueError, KeyError, json.JSONDecodeError, subprocess.SubprocessError):
        print("D3_ACCEPTANCE_FAIL reason=collector-contract", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
