#!/usr/bin/env python3
"""Reconcile formal Argus workload retirements into private M1 state."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from argus_m1_retired_workloads import RetirementReconcileError, reconcile_retired_workloads


ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description="Remove only formally retired workload records from private Argus M1 state.")
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--acknowledge-retired-workload-reconciliation", action="store_true")
    args = parser.parse_args()
    if args.apply and not args.acknowledge_retired_workload_reconciliation:
        raise SystemExit("refusing apply without --acknowledge-retired-workload-reconciliation")
    try:
        print(json.dumps(reconcile_retired_workloads(args.root, apply=args.apply), sort_keys=True))
    except RetirementReconcileError as exc:
        raise SystemExit(f"Argus retired workload reconciliation failed: {exc}") from exc
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
